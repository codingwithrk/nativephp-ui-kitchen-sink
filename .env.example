APP_NAME="NativePHP UI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── NativePHP ────────────────────────────────────────────────────────────────
# Your bundle / application ID. It must be unique to you; set it before
# running `php artisan native:install`.
NATIVEPHP_APP_ID=com.yourname.nativephpui
NATIVEPHP_APP_VERSION=1.0.0
NATIVEPHP_APP_VERSION_CODE=1
# iOS only: your Apple Developer Team ID, for signing.
NATIVEPHP_DEVELOPMENT_TEAM=

# ─── In-app updates ───────────────────────────────────────────────────────────
# The endpoint that reports the latest store release per platform (see
# "In-app updates" in README.md). Leave empty to turn the check off.
APP_UPDATE_URL=

# ─── Google AdMob (bhargavdetroja/nativephp-google-mobile-ads) ─────────────────
# While APP_ENV is not "production", Google's test ads are shown and these
# IDs aren't used, so you can leave the placeholders while developing.
# Set ADMOB_ENABLED=false to turn ads off entirely.
ADMOB_ENABLED=true

# App IDs, from AdMob → Apps (one per platform). The iOS app crashes on
# launch without ADMOB_IOS_APP_ID, so set it before building for iOS.
ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX

# The banner shown at the bottom of component and template pages. Create a
# "Banner" ad unit in AdMob → Ad units.
ADMOB_ANCHORED_ADAPTIVE_BANNER_AD_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
